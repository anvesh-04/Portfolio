---
import {
  ACHIEVEMENTS,
  EDUCATION,
  EXPERIENCE,
  PERSON,
  SKILL_GROUPS,
} from "@/config";
---

<section
  id="about"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Background</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">About</h3>

    <p class="text-[var(--white-icon)] text-base md:text-lg max-w-3xl">
      {PERSON.summary}
    </p>

    <!-- Experience timeline -->
    <h4 class="text-2xl font-semibold mt-12 mb-6">Experience</h4>
    <ol class="relative border-l border-[#ffffff14] ml-2 space-y-8">
      {
        EXPERIENCE.map((item) => (
          <li class="pl-6 md:pl-8">
            <span
              class="absolute -left-[7px] mt-2 size-3.5 rounded-full bg-[var(--sec)] ring-4 ring-[var(--background)]"
              aria-hidden="true"
            />
            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
              <h5 class="text-lg font-medium">{item.role}</h5>
              <span class="text-sm text-[var(--white-icon)] whitespace-nowrap">
                {item.period}
              </span>
            </div>
            <p class="text-sm text-[var(--sec)] mt-1">{item.org}</p>
            <ul class="mt-3 space-y-2">
              {item.points.map((point) => (
                <li class="text-sm text-[var(--white-icon)] flex items-start gap-3">
                  <span class="text-[var(--sec)] leading-6">•</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <!-- Technical skills -->
    <h4 class="text-2xl font-semibold mt-14 mb-6">Technical skills</h4>
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        Object.entries(SKILL_GROUPS).map(([group, items]) => (
          <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5">
            <dt class="text-sm uppercase tracking-wider text-[var(--sec)] mb-3">
              {group}
            </dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {items.map((item) => (
                  <li class="text-xs px-3 py-1.5 rounded-lg border border-[var(--white-icon-tr)] text-[var(--white-icon)] bg-[#ffffff08]">
                    {item}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mt-14">
      <!-- Achievements -->
      <div>
        <h4 class="text-2xl font-semibold mb-6">Achievements</h4>
        <ul class="space-y-4">
          {
            ACHIEVEMENTS.map((item) => (
              <li class="flex items-start gap-3 text-sm text-[var(--white-icon)]">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5 shrink-0 text-[var(--sec)]"
                  aria-hidden="true"
                >
                  <path d="M12 15C8.6863 15 6 12.3137 6 9V3.00087L18 3V9C18 12.3137 15.3137 15 12 15ZM4 4H2V8H4V4ZM20 4V8H22V4H20ZM11 17H13V20H17V22H7V20H11V17Z" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Education -->
      <div>
        <h4 class="text-2xl font-semibold mb-6">Education</h4>
        <ul class="space-y-4">
          {
            EDUCATION.map((item) => (
              <li class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5">
                <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                  <h5 class="font-medium">{item.school}</h5>
                  {item.period && (
                    <span class="text-xs text-[var(--white-icon)] whitespace-nowrap">
                      {item.period}
                    </span>
                  )}
                </div>
                {item.detail && (
                  <p class="text-sm text-[var(--white-icon)] mt-2">
                    {item.detail}
                  </p>
                )}
                <p class="text-sm text-[var(--sec)] mt-1">{item.score}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
