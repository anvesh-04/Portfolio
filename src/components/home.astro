---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "./logoWall.astro";
import SocialLinks from "./socialLinks.astro";
import SkillsList from "../React/SkillsList.tsx";
import { PERSON, STATS } from "@/config";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
        Hi, I'm {PERSON.name}
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
        >
          Full-Stack <br /> Developer
        </h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)]">
          Building distributed, algorithmically-optimized systems on the <span
            class="text-[var(--sec)] shiny-sec">MERN</span
          > stack — from graph-based scheduling engines to Redis-backed rate limiters.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 pt-3 md:pt-6">
        <SocialLinks />
        <a
          href={PERSON.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 h-[56px] px-5 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-6"
            aria-hidden="true"
          >
            <path
              d="M13 10H18L12 16L6 10H11V3H13V10ZM4 19H20V12H22V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V12H4V19Z"
            ></path>
          </svg>
          <span class="text-sm md:text-base font-medium">Résumé</span>
        </a>
      </div>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-4">
      {
        STATS.map((stat) => (
          <div class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] px-4 py-4">
            <dt class="sr-only">{stat.label}</dt>
            <dd>
              <span class="block text-2xl md:text-3xl font-semibold text-[var(--sec)]">
                {stat.value}
              </span>
              <span class="block text-xs md:text-sm text-[var(--white-icon)] mt-1">
                {stat.label}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
