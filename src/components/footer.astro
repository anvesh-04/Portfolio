---
import SocialLinks from "./socialLinks.astro";
import { PERSON, SOCIALS } from "@/config";

const currentYear = new Date().getFullYear();
const asset = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\/+/, "")}`;

const tech = [
  { desc: "Built with", name: "Astro", icon: "/svg/astro.svg" },
  { desc: "Styled with", name: "TailwindCSS", icon: "/svg/tailwindcss.svg" },
  { desc: "Deployed on", name: "Vercel", icon: "/svg/vercel.svg" },
];

const quickLinks = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
  { label: "Résumé", href: PERSON.resume },
];

const profiles = [
  { label: "LeetCode", href: SOCIALS.leetcode, note: "400+ problems" },
  { label: "Codeforces", href: SOCIALS.codeforces, note: "Pupil" },
  { label: "GitHub", href: SOCIALS.github, note: "@anvesh-04" },
];
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <div class="lg:col-span-2 flex flex-col items-center lg:items-start gap-5">
        <div>
          <p class="text-[var(--white)] text-xl font-semibold text-center lg:text-left">
            {PERSON.name}
          </p>
          <p class="text-[var(--white-icon)] text-sm mt-2 max-w-sm text-center lg:text-left">
            {PERSON.role} · {PERSON.location}
          </p>
        </div>
        <div class="flex space-x-6 sm:space-x-7">
          <SocialLinks bare iconClass="size-7" />
        </div>
      </div>

      <nav class="flex flex-col items-center lg:items-start gap-4" aria-label="Footer">
        <h2 class="text-[var(--white)] text-sm font-medium">Navigate</h2>
        <ul class="space-y-2 text-center lg:text-left">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col items-center lg:items-start gap-4">
        <h2 class="text-[var(--white)] text-sm font-medium">Profiles</h2>
        <ul class="space-y-2 text-center lg:text-left">
          {
            profiles.map((profile) => (
              <li>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
                >
                  {profile.label}
                  <span class="text-[var(--sec)] ml-1.5 text-xs">
                    {profile.note}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 pt-8 border-t border-[#ffffff10] flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="text-sm text-[var(--white-icon)] text-center md:text-left">
        <!-- If you are using this template, by MIT License you can't remove the copyright notice -->
        Copyright © {currentYear} {PERSON.name}. All rights reserved.
      </p>
      <div class="flex flex-wrap justify-center gap-x-5 gap-y-2">
        {
          tech.map((item) => (
            <div class="flex items-center space-x-2">
              <span class="text-[var(--white-icon)] text-xs">{item.desc}</span>
              <img
                src={asset(item.icon)}
                alt={`${item.name} logo`}
                class="h-4 w-4 object-contain filter brightness-0 invert opacity-50"
                width="16"
                height="16"
                loading="lazy"
              />
              <span class="text-[var(--white-icon)] text-xs">{item.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</footer>
